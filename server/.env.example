PORT=5000
# Local standalone mongod works out of the box. If you started mongod with
# --replSet rs0 (enables transactions), use:
#   mongodb://127.0.0.1:27017/assetflow?replicaSet=rs0
MONGO_URI=mongodb://127.0.0.1:27017/assetflow
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_EXPIRES=45m
JWT_REFRESH_EXPIRES=7d
CLIENT_ORIGIN=http://localhost:5173
